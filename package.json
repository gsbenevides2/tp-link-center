    "Dashboard",
    "Devices"
  ],
  "scripts": {
    "dev": "bun --bun next dev --webpack",
    "build": "bun --bun next build --webpack",
    "start": "bun --bun next start",
    "lint": "eslint",
    "db:sync": "bun --bun run drizzle-kit push --config server/db/drizzle.config.ts",
    "db:studio": "bun --bun run drizzle-kit studio --config server/db/drizzle.config.ts"
  },
  "dependencies": {
    "@elysia/eden": "^1.4.10",
