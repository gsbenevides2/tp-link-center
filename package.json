    "next": "16.2.10",
    "puppeteer-core": "^25.10.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "tp-link-center": ".",
    "zod": "^4.5.4"
