{
  "name": "@gsbenevides2/tp-link-center",
  "displayName": "TP Link Center",
  "version": "0.0.33",
  "private": false,
  "description": "TP Link Center is Admin Dashboard to manager my tplink routers.",
  "author": {
    "email": "git@gui.dev.br",
    "name": "Guilherme da Silva Benevides",
    "url": "https://www.gui.dev.br"
  },
  "types": "./dist/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts"
    }
